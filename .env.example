NODE_ENV=development
PORT=4000
# Standalone local Mongo. Point this at a replica set before using multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# Comma-separated browser origins. Credentials require this allow-list.
CLIENT_ORIGIN=http://localhost:3000

# Dev-only placeholders. Replace with long random strings before any shared deploy.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars

# httpOnly defaults on. Secure defaults to true in production when COOKIE_SECURE is omitted.
# SameSite=none is rejected unless COOKIE_SECURE=true.
COOKIE_HTTPONLY=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
